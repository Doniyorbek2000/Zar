// ZarPOS — domen modeli
// Restoran/kafe avtomatlashtirish: menyu, texkartalar, POS, ombor, kassa, hisobot

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Tashkilot va filiallar (multi-branch)
// ============================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("UZS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users          User[]
  halls          Hall[]
  orders         Order[]
  shifts         Shift[]
  stocks         Stock[]
  stockMovements StockMovement[]

  @@index([companyId])
}

// ============================================================
// Foydalanuvchilar va rollar (RBAC)
// ============================================================

enum Role {
  ADMIN // Tizim administratori
  MANAGER // Menejer
  CASHIER // Kassir
  WAITER // Ofitsiant
  COOK // Oshpaz (KDS)
}

model User {
  id           String   @id @default(cuid())
  branchId     String?
  fullName     String
  username     String   @unique
  passwordHash String
  pinHash      String? // POS terminaliga tez kirish uchun PIN
  role         Role     @default(WAITER)
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  ordersOpened  Order[]        @relation("OrderOpenedBy")
  ordersServed  Order[]        @relation("OrderWaiter")
  payments      Payment[]
  shifts        Shift[]
  stockMovements StockMovement[]

  @@index([branchId])
}

// ============================================================
// Zallar va stollar
// ============================================================

model Hall {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables Table[]

  @@index([branchId])
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

model Table {
  id        String      @id @default(cuid())
  hallId    String
  name      String // masalan "Stol 1"
  seats     Int         @default(4)
  posX      Int         @default(0)
  posY      Int         @default(0)
  status    TableStatus @default(FREE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  hall   Hall    @relation(fields: [hallId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([hallId])
}

// ============================================================
// Menyu: kategoriyalar, taomlar, modifikatorlar
// ============================================================

enum ProductType {
  DISH // Texkartaga ega tayyor taom
  GOODS // Tayyor tovar (sotib olib sotiladi, masalan gazlangan suv)
  PREPARATION // Yarim tayyor mahsulot (zagotovka)
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  categoryId  String
  name        String
  description String?
  type        ProductType @default(DISH)
  price       Decimal     @db.Decimal(14, 2) // sotuv narxi
  imageUrl    String?
  unit        String      @default("dona") // sotuv birligi
  isActive    Boolean     @default(true)
  inStopList  Boolean     @default(false) // stop-list: vaqtincha yo'q
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category       Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recipeItems    RecipeItem[]
  orderItems     OrderItem[]
  modifierGroups ProductModifierGroup[]

  @@index([categoryId])
}

model ModifierGroup {
  id          String   @id @default(cuid())
  name        String // masalan "Qo'shimchalar", "Pishirilish darajasi"
  minSelect   Int      @default(0)
  maxSelect   Int      @default(1)
  isRequired  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modifiers Modifier[]
  products  ProductModifierGroup[]
}

model Modifier {
  id      String  @id @default(cuid())
  groupId String
  name    String // masalan "Qo'shimcha pishloq"
  price   Decimal @db.Decimal(14, 2) @default(0)
  isActive Boolean @default(true)

  group          ModifierGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemMods  OrderItemModifier[]

  @@index([groupId])
}

// Product <-> ModifierGroup ko'p-ko'pga
model ProductModifierGroup {
  productId String
  groupId   String

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
}

// ============================================================
// Ombor: ingredientlar, texkartalar, yetkazib beruvchilar
// ============================================================

enum StockUnit {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PIECE
}

model Ingredient {
  id          String    @id @default(cuid())
  name        String
  unit        StockUnit @default(GRAM)
  costPerUnit Decimal   @db.Decimal(14, 4) @default(0) // oxirgi tannarx (birlik uchun)
  minQuantity Decimal   @db.Decimal(14, 3) @default(0) // minimal qoldiq (ogohlantirish)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recipeItems    RecipeItem[]
  stocks         Stock[]
  stockMovements StockMovement[]
  supplyItems    SupplyItem[]
}

// Texnologik karta (retsept) elementi: taom -> ingredient sarf normasi
model RecipeItem {
  id           String  @id @default(cuid())
  productId    String
  ingredientId String
  quantity     Decimal @db.Decimal(14, 3) // bir portsiyaga sarf (ingredient birligida)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@index([productId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  inn       String? // STIR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplies Supply[]
}

// Kirim (prixod) hujjati
model Supply {
  id         String   @id @default(cuid())
  supplierId String?
  branchId   String
  docNumber  String?
  total      Decimal  @db.Decimal(14, 2) @default(0)
  note       String?
  createdAt  DateTime @default(now())

  supplier Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    SupplyItem[]

  @@index([supplierId])
}

model SupplyItem {
  id           String  @id @default(cuid())
  supplyId     String
  ingredientId String
  quantity     Decimal @db.Decimal(14, 3)
  unitPrice    Decimal @db.Decimal(14, 4)

  supply     Supply     @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([supplyId])
}

// Filialdagi ingredient qoldig'i
model Stock {
  id           String  @id @default(cuid())
  branchId     String
  ingredientId String
  quantity     Decimal @db.Decimal(14, 3) @default(0)

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([branchId, ingredientId])
  @@index([branchId])
}

enum StockMovementType {
  SUPPLY // Kirim
  SALE // Sotuv natijasida chiqim
  WRITE_OFF // Spisaniye (buzilgan, yaroqsiz)
  INVENTORY // Inventarizatsiya tuzatishi
  RETURN // Qaytarish
}

// Ombor harakati jurnali (audit)
model StockMovement {
  id           String            @id @default(cuid())
  branchId     String
  ingredientId String
  type         StockMovementType
  quantity     Decimal           @db.Decimal(14, 3) // + kirim / - chiqim
  cost         Decimal           @db.Decimal(14, 2) @default(0)
  reason       String?
  orderId      String?
  userId       String?
  createdAt    DateTime          @default(now())

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([ingredientId])
  @@index([orderId])
}

// ============================================================
// Mijozlar (loyalty)
// ============================================================

model Customer {
  id           String   @id @default(cuid())
  fullName     String
  phone        String?  @unique
  cardNumber   String?  @unique
  bonusBalance Decimal  @db.Decimal(14, 2) @default(0)
  discountPct  Decimal  @db.Decimal(5, 2) @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
}

// ============================================================
// Buyurtmalar (POS)
// ============================================================

enum OrderType {
  DINE_IN // Zalda
  TAKEAWAY // O'zi bilan olib ketish
  DELIVERY // Yetkazib berish
}

enum OrderStatus {
  OPEN // Ochiq (qabul qilinmoqda)
  SENT // Oshxonaga yuborilgan
  READY // Tayyor
  PAID // To'langan / yopilgan
  CANCELLED // Bekor qilingan
}

model Order {
  id          String      @id @default(cuid())
  branchId    String
  number      Int // filial ichida ketma-ket raqam
  type        OrderType   @default(DINE_IN)
  status      OrderStatus @default(OPEN)
  tableId     String?
  waiterId    String?
  openedById  String?
  customerId  String?
  guests      Int         @default(1)

  subtotal    Decimal     @db.Decimal(14, 2) @default(0) // chegirmasiz
  discountPct Decimal     @db.Decimal(5, 2) @default(0)
  discountAmt Decimal     @db.Decimal(14, 2) @default(0)
  serviceFeePct Decimal   @db.Decimal(5, 2) @default(0) // xizmat haqi %
  serviceFeeAmt Decimal   @db.Decimal(14, 2) @default(0)
  total       Decimal     @db.Decimal(14, 2) @default(0) // yakuniy summa
  note        String?

  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  updatedAt  DateTime  @updatedAt

  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table     Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  waiter    User?       @relation("OrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  openedBy  User?       @relation("OrderOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  customer  Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]
  stockMovements StockMovement[]

  @@unique([branchId, number])
  @@index([branchId, status])
  @@index([tableId])
}

enum OrderItemStatus {
  NEW
  SENT
  READY
  SERVED
  CANCELLED
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  productId  String
  name       String // buyurtma paytidagi nom (tarixiy)
  quantity   Decimal         @db.Decimal(14, 3) @default(1)
  unitPrice  Decimal         @db.Decimal(14, 2) // buyurtma paytidagi narx
  cost       Decimal         @db.Decimal(14, 2) @default(0) // texkarta bo'yicha tannarx
  status     OrderItemStatus @default(NEW)
  note       String?
  createdAt  DateTime        @default(now())

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifiers OrderItemModifier[]

  @@index([orderId])
}

model OrderItemModifier {
  id          String  @id @default(cuid())
  orderItemId String
  modifierId  String
  name        String
  price       Decimal @db.Decimal(14, 2) @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier  @relation(fields: [modifierId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
}

// ============================================================
// To'lovlar va kassa smenalari
// ============================================================

enum PaymentMethod {
  CASH
  CARD
  TRANSFER // O'tkazma / QR
  BONUS
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  shiftId   String?
  userId    String?
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2)
  createdAt DateTime      @default(now())

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([shiftId])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

// Kassa smenasi
model Shift {
  id            String      @id @default(cuid())
  branchId      String
  userId        String
  status        ShiftStatus @default(OPEN)
  openingCash   Decimal     @db.Decimal(14, 2) @default(0)
  closingCash   Decimal?    @db.Decimal(14, 2)
  openedAt      DateTime    @default(now())
  closedAt      DateTime?

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([branchId, status])
}
